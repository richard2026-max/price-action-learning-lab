# Price Action Learning Lab - 本地环境配置示例
# 复制为 .env 使用；密钥不入 Git（.gitignore 已排除 .env）

# 数据目录（默认仓库 data/）
# PALL_DATA_DIR=./data

# SQLite 应用数据库路径（默认 data/app.sqlite）
# PALL_SQLITE_PATH=./data/app.sqlite

# 合成数据种子（同种子 => 同数据，可复现）
# PALL_SYNTHETIC_SEED=20260816

# ---- Alpaca 市场数据密钥（可选；仅市场数据，与交易权限无关）----
# PALL_ALPACA_KEY_ID=
# PALL_ALPACA_SECRET_KEY=
# PALL_ALPACA_FEED=iex

# ---- HF Data Library（免费 SPY 1m 历史数据；https://hfdatalibrary.com 注册获取）----
# PALL_HFDL_API_KEY=
# PALL_HFDL_BASE_URL=https://api.hfdatalibrary.com/v1

# ---- AI（默认禁用；关闭时核心功能正常）----
# PALL_AI_ENABLED=false
