# Price Action Learning Lab - 本地环境配置示例
# 复制为 .env 使用；密钥不入 Git（.gitignore 已排除 .env）

# 数据目录（默认仓库 data/）
# PALL_DATA_DIR=./data

# SQLite 应用数据库路径（默认 data/app.sqlite）
# PALL_SQLITE_PATH=./data/app.sqlite

# 合成数据种子（同种子 => 同数据，可复现）
# PALL_SYNTHETIC_SEED=20260816

# ---- 小程序认证（生产环境必须配置）----
# PALL_AUTH_TOKEN_SECRET=请使用至少32字节随机密钥
# PALL_AUTH_TOKEN_TTL_SECONDS=604800
# PALL_LEGACY_LOCAL_USER_ENABLED=true
# PALL_WECHAT_APP_ID=
# PALL_WECHAT_APP_SECRET=
# 个人体验版可用逗号分隔的 openid 白名单；留空表示不限制
# PALL_WECHAT_ALLOWED_OPENIDS=

# ---- Alpaca 市场数据密钥（可选；仅市场数据，与任何交易权限无关）----
# PALL_ALPACA_KEY_ID=
# PALL_ALPACA_SECRET_KEY=
# PALL_ALPACA_FEED=iex

# ---- HF Data Library（免费 SPY 1m 历史数据；https://hfdatalibrary.com 注册获取）----
# PALL_HFDL_API_KEY=
# PALL_HFDL_BASE_URL=https://api.hfdatalibrary.com/v1

# ---- AI 教练（默认禁用；关闭时核心功能正常）----
# PALL_AI_ENABLED=false
# PALL_AI_BASE_URL=https://api.deepseek.com/v1
# PALL_AI_API_KEY=
# PALL_AI_MODEL=deepseek-chat
# PALL_AI_TEMPERATURE=0.2

# ---- 学习资料（默认使用仓库外的 AlBrooks书 / AlBrooks课件）----
# PALL_BOOKS_DIR=../AlBrooks书
# PALL_COURSEWARE_DIR=../AlBrooks课件
# PALL_KNOWLEDGE_CACHE_PATH=./data/cache/knowledge_index.json
